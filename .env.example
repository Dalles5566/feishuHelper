# =============================================================================
# Feishu Helper — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values before starting the application.
# Lines starting with # are comments and are ignored.
# NEVER commit your actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Feishu Open Platform (REQUIRED)
# Obtain these from https://open.feishu.cn/app → your app → Credentials & Basic Info
# -----------------------------------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook verification token — found in Event Subscriptions → Verification Token
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Encrypt key for event payload decryption (optional, leave empty if not enabled)
FEISHU_ENCRYPT_KEY=

# -----------------------------------------------------------------------------
# LLM Provider (REQUIRED)
# -----------------------------------------------------------------------------
# Provider: 'openai' or 'anthropic'
LLM_PROVIDER=openai

# API key for the chosen provider
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model name to use
# OpenAI examples:   gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic examples: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
LLM_MODEL=gpt-4o

# Maximum tokens per LLM request (default: 4096)
LLM_MAX_TOKENS=4096

# LLM request timeout in milliseconds (default: 60000)
LLM_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# PostgreSQL Database (REQUIRED: DB_PASSWORD)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=feishu_helper
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# Connection pool settings (optional — defaults shown)
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Redis (used by BullMQ for job queues)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis password (leave empty if no auth is configured)
REDIS_PASSWORD=

# Redis database index 0-15 (default: 0)
REDIS_DB=0

# Connection timeout in milliseconds (default: 5000)
REDIS_CONNECT_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# HTTP server port (default: 3000)
PORT=3000

# Bind host (default: 0.0.0.0)
HOST=0.0.0.0

# Runtime environment: development | production | test
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Retry settings for external API calls (Feishu, LLM)
# Maximum number of retry attempts (default: 3)
MAX_RETRIES=3

# Base delay in milliseconds for exponential backoff (default: 1000)
RETRY_BASE_DELAY_MS=1000

# Maximum delay cap in milliseconds for exponential backoff (default: 30000)
RETRY_MAX_DELAY_MS=30000
